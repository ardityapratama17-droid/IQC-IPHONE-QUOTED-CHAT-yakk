    <script>
        // Konfigurasi dasar
        const BG_URL = "https://raw.githubusercontent.com/ryyntwx/allimagerin/refs/heads/main/Iqcbyrin.png";
        const EMOJI_JSON_URL = "https://media.githubusercontent.com/media/Ditzzx-vibecoder/entahlah/main/emoji-apple.json";
        const BG_W = 906;
        const BG_H = 1736;
        const SX = BG_W / 1080;
        const SY = BG_H / 2280;

        let appleEmojiMap = null;

        // Muat gambar
        function loadImage(url) {
            return new Promise((resolve, reject) => {
                const img = new Image();
                img.crossOrigin = 'anonymous';
                img.onload = () => resolve(img);
                img.onerror = () => reject(new Error(`Gagal memuat: ${url}`));
                img.src = url;
            });
        }

        // Muat peta emoji Apple
        async function loadAppleEmojiMap() {
            if (appleEmojiMap) return appleEmojiMap;
            try {
                const res = await fetch(EMOJI_JSON_URL);
                appleEmojiMap = await res.json();
                return appleEmojiMap;
            } catch (err) {
                console.warn('Tidak bisa memuat emoji khusus, gunakan emoji standar');
                return null;
            }
        }

        // Ubah emoji ke kode unicode
        function emojiToUnicode(emoji) {
            return [...emoji].map(c => c.codePointAt(0).toString(16)).join('-');
        }

        // Gambar emoji Apple resolusi tinggi
        async function drawAppleEmoji(ctx, emoji, x, y, size) {
            const map = await loadAppleEmojiMap();
            if (!map) {
                ctx.font = `${size}px "Apple Color Emoji", "Segoe UI Emoji", sans-serif`;
                ctx.fillText(emoji, x, y);
                return;
            }
            const base = emojiToUnicode(emoji);
            const variants = [base, base.replace(/-fe0f/g, ''), base.toUpperCase(), base.replace(/-fe0f/g, '').toUpperCase()];
            let b64 = null;
            for (const v of variants) if (map[v]) { b64 = map[v]; break; }
            if (!b64) {
                ctx.font = `${size}px "Apple Color Emoji", "Segoe UI Emoji", sans-serif`;
                ctx.fillText(emoji, x, y);
                return;
            }
            const img = new Image();
            img.src = `data:image/png;base64,${b64}`;
            await new Promise(r => img.onload = r);
            ctx.drawImage(img, x - size / 2, y - size / 2, size, size);
        }

        // Gambar kotak sudut membulat
        function drawRoundedRect(ctx, x, y, w, h, r) {
            ctx.beginPath();
            ctx.moveTo(x + r, y);
            ctx.lineTo(x + w - r, y);
            ctx.quadraticCurveTo(x + w, y, x + w, y + r);
            ctx.lineTo(x + w, y + h - r);
            ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
            ctx.lineTo(x + r, y + h);
            ctx.quadraticCurveTo(x, y + h, x, y + h - r);
            ctx.lineTo(x, y + r);
            ctx.quadraticCurveTo(x, y, x + r, y);
            ctx.closePath();
        }

        // Ukur lebar teks termasuk emoji
        function measureTextCustom(ctx, text, fontSize) {
            const parts = text.split(/(\p{Extended_Pictographic})/gu);
            let total = 0;
            for (const p of parts) {
                if (!p) continue;
                if (/\p{Extended_Pictographic}/u.test(p)) total += fontSize * 1.05;
                else total += ctx.measureText(p).width;
            }
            return total;
        }

        // Bungkus teks agar tidak melar
        function wrapText(ctx, text, maxWidth, fontSize) {
            ctx.font = `500 ${fontSize}px Inter, system-ui, sans-serif`;
            const words = text.split(" ");
            const lines = [];
            let currentLine = "";

            for (const word of words) {
                const testLine = currentLine ? `${currentLine} ${word}` : word;
                const lineWidth = measureTextCustom(ctx, testLine, fontSize);

                if (lineWidth <= maxWidth) {
                    currentLine = testLine;
                } else {
                    if (currentLine) lines.push(currentLine);
                    currentLine = word;
                }
            }

            if (currentLine) lines.push(currentLine);
            return lines;
        }

        // Gambar teks lengkap dengan emoji
        async function drawTextWithEmojis(ctx, text, x, y, fontSize) {
            const parts = text.split(/(\p{Extended_Pictographic})/gu);
            let currentX = x;
            for (const p of parts) {
                if (!p) continue;
                if (/\p{Extended_Pictographic}/u.test(p)) {
                    const size = fontSize * 1.05;
                    await drawAppleEmoji(ctx, p, currentX + size / 2, y, size);
                    currentX += size;
                } else {
                    ctx.fillText(p, currentX, y);
                    currentX += ctx.measureText(p).width;
                }
            }
        }

        // Fungsi utama buat gambar
        async function generateImage() {
            const text = document.getElementById('chatText').value.trim() || "Kesendirian adalah teman terbaik ku😂😂";
            const time = document.getElementById('timeText').value.trim() || "22.54";
            const bubbleColor = document.getElementById('bubbleColor').value;
            const textColor = document.getElementById('textColor').value;
            const timeColor = document.getElementById('timeColor').value;
            const tickColor = document.getElementById('tickColor').value;
            const showReaction = document.getElementById('showReaction').checked;

            const canvas = document.getElementById('canvas');
            const ctx = canvas.getContext('2d');
            ctx.imageSmoothingEnabled = true;
            ctx.imageSmoothingQuality = 'high';

            try {
                const bg = await loadImage(BG_URL);
                ctx.clearRect(0, 0, BG_W, BG_H);
                ctx.drawImage(bg, 0, 0, BG_W, BG_H);

                // Ukuran pas seperti aslinya
                const fontSize = Math.round(45 * SX);
                const bubbleWidth = Math.round(746 * SX);
                const textPaddingX = Math.round(36 * SX);
                const paddingTop = Math.round(28 * SY);
                const paddingBottom = Math.round(28 * SY);
                const radius = Math.round(32 * SX);
                const rightPadding = Math.round(80 * SX);
                const menuTopBorderY = Math.round(1276 * SY);
                const timeFontSize = Math.round(23 * SX);
                const lineGap = Math.round(12 * SY);

                // Hitung lebar gelembung otomatis
                ctx.font = `500 ${fontSize}px Inter, system-ui, sans-serif`;
                const lines = wrapText(ctx, text, bubbleWidth - textPaddingX * 2, fontSize);
                const lineWidths = lines.map(line => measureTextCustom(ctx, line, fontSize));
                const maxLineWidth = Math.max(...lineWidths, 0);
                const timeWidth = ctx.measureText(time).width + Math.round(46 * SX);
                let bubbleActualW = maxLineWidth + textPaddingX * 2;
                const minBubbleW = Math.round(280 * SX);
                if (bubbleActualW < minBubbleW) bubbleActualW = minBubbleW;
                if (bubbleActualW > bubbleWidth) bubbleActualW = bubbleWidth;

                const bubbleX = BG_W - bubbleActualW - rightPadding;
                const textTotalHeight = lines.length * fontSize + (lines.length - 1) * lineGap;
                const bubbleHeight = paddingTop + textTotalHeight + paddingBottom;
                const bubbleY = menuTopBorderY - bubbleHeight - Math.round(28 * SY);

                // Gambar gelembung + ekor
                ctx.save();
                ctx.shadowColor = "rgba(0,0,0,0.05)";
                ctx.shadowBlur = 20;
                ctx.shadowOffsetY = 6;
                ctx.fillStyle = bubbleColor;
                drawRoundedRect(ctx, bubbleX, bubbleY, bubbleActualW, bubbleHeight, radius);
                ctx.fill();
                ctx.restore();

                // Ekor gelembung kanan
                ctx.beginPath();
                ctx.moveTo(bubbleX + bubbleActualW - Math.round(15 * SX), bubbleY + bubbleHeight - 5);
                ctx.lineTo(bubbleX + bubbleActualW + Math.round(10 * SX), bubbleY + bubbleHeight - 5);
                ctx.quadraticCurveTo(
                    bubbleX + bubbleActualW + Math.round(2 * SX),
                    bubbleY + bubbleHeight - Math.round(20 * SY),
                    bubbleX + bubbleActualW - Math.round(1 * SX),
                    bubbleY + bubbleHeight - Math.round(32 * SY)
                );
                ctx.fillStyle = bubbleColor;
                ctx.fill();

                // Gambar teks
                ctx.fillStyle = textColor;
                ctx.font = `500 ${fontSize}px Inter, system-ui, sans-serif`;
                ctx.textAlign = 'left';
                ctx.textBaseline = 'middle';
                for (let i = 0; i < lines.length; i++) {
                    const y = bubbleY + paddingTop + (i * (fontSize + lineGap)) + fontSize / 2;
                    await drawTextWithEmojis(ctx, lines[i], bubbleX + textPaddingX, y, fontSize);
                }

                // Gambar waktu & centang
                const timeY = bubbleY + bubbleHeight - paddingBottom - timeFontSize + Math.round(4 * SY);
                const timeX = bubbleX + bubbleActualW - textPaddingX - timeWidth;
                ctx.fillStyle = timeColor;
                ctx.font = `600 ${timeFontSize}px Inter, system-ui, sans-serif`;
                ctx.textBaseline = 'top';
                ctx.fillText(time, timeX, timeY);

                // Gambar centang ganda
                const tickX = timeX + ctx.measureText(time).width + Math.round(10 * SX);
                const tickY = timeY + (timeFontSize / 2) - Math.round(8 * SX);
                ctx.strokeStyle = tickColor;
                ctx.lineWidth = 3.6 * SX;
                ctx.lineCap = "round";
                ctx.lineJoin = "round";
                ctx.beginPath();
                ctx.moveTo(tickX, tickY + Math.round(8 * SX));
                ctx.lineTo(tickX + Math.round(6 * SX), tickY + Math.round(14 * SX));
                ctx.lineTo(tickX + Math.round(16 * SX), tickY + Math.round(2 * SX));
                ctx.stroke();
                ctx.beginPath();
                ctx.moveTo(tickX + Math.round(7 * SX), tickY + Math.round(8 * SX));
                ctx.lineTo(tickX + Math.round(13 * SX), tickY + Math.round(14 * SX));
                ctx.lineTo(tickX + Math.round(23 * SX), tickY + Math.round(2 * SX));
                ctx.stroke();

                // Gambar reaksi emoji
                if (showReaction) {
                    const emojis = ["👍", "❤️", "😂", "😮", "😢", "🙏"];
                    const emojiSize = Math.round(90 * SX);
                    const emojiSpacing = Math.round(110 * SX);
                    const rxHeight = Math.round(160 * SX);
                    const startPad = Math.round(52 * SX);
                    const rxWidth = startPad + (emojis.length - 1) * emojiSpacing + Math.round(130 * SX);
                    const rxX = bubbleX + bubbleActualW - rxWidth;
                    const rxY = bubbleY - rxHeight + Math.round(10 * SY);

                    ctx.save();
                    ctx.shadowColor = "rgba(0,0,0,0.12)";
                    ctx.shadowBlur = 36;
                    ctx.shadowOffsetY = 16;
                    ctx.fillStyle = "#FFFFFF";
                    drawRoundedRect(ctx, rxX, rxY, rxWidth, rxHeight, rxHeight / 2);
                    ctx.fill();
                    ctx.restore();

                    const emojiCY = rxY + rxHeight / 2;
                    for (let i = 0; i < emojis.length; i++) {
                        await drawAppleEmoji(ctx, emojis[i], rxX + startPad + i * emojiSpacing, emojiCY, emojiSize);
                    }

                    // Tombol tambah reaksi
                    const plusX = rxX + startPad + (emojis.length - 1) * emojiSpacing + Math.round(90 * SX);
                    const plusR = Math.round(38 * SX);
                    ctx.beginPath();
                    ctx.arc(plusX, emojiCY, plusR, 0, Math.PI * 2);
                    ctx.fillStyle = "#E5E5EA";
                    ctx.fill();
                    ctx.strokeStyle = "#8E8E93";
                    ctx.lineWidth = 4.5 * SX;
                    ctx.beginPath();
                    ctx.moveTo(plusX - Math.round(13 * SX), emojiCY);
                    ctx.lineTo(plusX + Math.round(13 * SX), emojiCY);
                    ctx.moveTo(plusX, emojiCY - Math.round(13 * SX));
                    ctx.lineTo(plusX, emojiCY + Math.round(13 * SX));
                    ctx.stroke();
                }

                // Gambar menu opsi
                const menuY = menuTopBorderY;
                const menuW = Math.round(720 * SX);
                const menuX = BG_W - menuW - rightPadding;
                const menuH = Math.round(580 * SY);
                drawRoundedRect(ctx, menuX, menuY, menuW, menuH, Math.round(24 * SX));
                ctx.fillStyle = "#FFFFFF";
                ctx.shadowColor = "rgba(0,0,0,0.1)";
                ctx.shadowBlur = 20;
                ctx.shadowOffsetY = 8;
                ctx.fill();

                const menuItems = [
                    { text: "Balas", icon: "↩️" },
                    { text: "Teruskan", icon: "↪️" },
                    { text: "Salin", icon: "📋" },
                    { text: "Edit", icon: "✏️" },
                    { text: "Info", icon: "ⓘ" },
                    { text: "Beri bintang", icon: "⭐" },
                    { text: "Hapus", icon: "🗑️", color: "#E53935" }
                ];
                const itemH = Math.round(82 * SY);
                const iconX = menuX + Math.round(40 * SX);
                const textX = menuX + Math.round(90 * SX);
